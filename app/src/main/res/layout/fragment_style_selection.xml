<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#EEE7FA"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#6C4AB6"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose Style"
                    android:textColor="#403A48"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Choose the look for your headshot"
                    android:textColor="#77727F"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#E7E0EF" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#E7E0EF" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STYLE"
            android:textColor="#6C4AB6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Professional Appearance"
            android:textColor="#403A48"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select how you want your AI-generated portrait to look."
            android:textColor="#77727F"
            android:textSize="12sp" />

        <!-- Professional -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfessional"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#F1E9FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#E1D5F4"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="#E2D5FF"
                    android:gravity="center"
                    android:text="👔"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Professional"
                    android:textColor="#403A48"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Clean and polished"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Executive -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExecutive"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFF0F7"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#F1DCE8"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="#FFDCEB"
                    android:gravity="center"
                    android:text="💼"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Executive"
                    android:textColor="#403A48"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Premium corporate look"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Modern -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardModern"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EAF6FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#D8EAF7"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="#D8EEFF"
                    android:gravity="center"
                    android:text="✨"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Modern"
                    android:textColor="#403A48"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Fresh and contemporary"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Classic -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClassic"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFF7E8"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#F0E3C8"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="#FFECC7"
                    android:gravity="center"
                    android:text="📸"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Classic"
                    android:textColor="#403A48"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Timeless portrait style"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>