<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="AI Headshot"
                android:textColor="#403A48"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Creating Your AI Headshot"
            android:textColor="#403A48"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your photo is being transformed into a professional portrait."
            android:textColor="#77727F"
            android:textSize="13sp" />

        <!-- Photo preview with progress ring -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="5dp"
            app:strokeColor="#E9E1F4"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgGeneratingPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E7DAFF"
                    android:contentDescription="Selected photo preview"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66231648" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressRing"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:indeterminate="false"
                    app:indicatorColor="#FFFFFF"
                    app:indicatorSize="96dp"
                    app:trackColor="#55FFFFFF"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress bar + status -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#F1E9FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preparing your headshot..."
                    android:textColor="#6C4AB6"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressGeneration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminate="false"
                    app:indicatorColor="#6C4AB6"
                    app:trackColor="#E1D5F4"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="8dp" />



            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Selected Options -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="YOUR SELECTIONS"
            android:textColor="#6C4AB6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSelectedProfession"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#FFF0F7"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#403A48"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvSelectedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#EAF6FF"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#403A48"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvSelectedBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#EAF8F0"
            android:padding="12dp"
            android:textColor="#403A48"
            android:textSize="11sp" />


        <TextView
            android:id="@+id/tvSelectedPose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F3EEFF"
            android:padding="12dp"
            android:textColor="#403A48"
            android:textSize="11sp" />

        <!-- Waiting -->

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Please wait while AI creates your portrait..."
            android:textColor="#77727F"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:text="This may take a moment"
            android:textColor="#A19AA9"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>