<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"

    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="#E8E2F2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Visual area -->
        <FrameLayout
            android:id="@+id/toolVisualContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/bg_tool_visual">

            <ImageView
                android:id="@+id/imgToolIcon"
                android:layout_width="96dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <!-- Tool title -->
        <TextView
            android:id="@+id/tvToolTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Remove Background"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Tool description -->
        <TextView
            android:id="@+id/tvToolDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Remove image background"
            android:textColor="#77727F"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>