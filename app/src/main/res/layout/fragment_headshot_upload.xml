<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_button"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Your Photo"
                    android:textColor="#403A48"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Choose a clear photo for your AI headshot"
                    android:textColor="#77727F"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />



        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="STEP 2 OF 2"
            android:textColor="#6C4AB6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Upload Area -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutUpload"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#F1E9FF"
            app:cardCornerRadius="28dp"
            app:cardElevation="3dp"
            app:strokeColor="#DCCDF5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="#E2D5FF"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Add Your Photo"
                    android:textColor="#403A48"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Use a clear front-facing photo with good lighting"
                    android:textColor="#77727F"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Preview -->

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="28dp"
            android:adjustViewBounds="true"
            android:background="#EEEAF5"
            android:contentDescription="Selected photo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Choose Photo -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="SELECT PHOTO"
            android:textColor="#6C4AB6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Choose from Gallery"
            android:textAllCaps="false"
            android:textColor="#6C4AB6"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#F1E9FF"
            app:cornerRadius="28dp"
            app:strokeColor="#DCCDF5"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Take a Photo"
            android:textAllCaps="false"
            android:textColor="#D14D92"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FFF0F7"
            app:cornerRadius="28dp"
            app:strokeColor="#F0D5E4"
            app:strokeWidth="1dp" />

        <!-- Photo Tips -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#EAF6FF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Photo Tips"
                    android:textColor="#3D83C6"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Face the camera directly&#10;• Make sure your face is clearly visible&#10;• Avoid sunglasses or heavy shadows"
                    android:textColor="#5E6872"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Generate -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_ai_headshot_button"
            android:text="✨ Generate AI Headshot"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="20dp"
            app:rippleColor="#55FFFFFF" />

    </LinearLayout>

</ScrollView>