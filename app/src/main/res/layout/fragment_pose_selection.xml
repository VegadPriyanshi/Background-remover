<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF8FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#EEE7FA"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#6C4AB6"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose Pose"
                    android:textColor="#403A48"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Choose a professional pose for your portrait"
                    android:textColor="#77727F"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Progress -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#6C4AB6" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#E7E0EF" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="POSE"
            android:textColor="#6C4AB6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Section -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Professional Poses"
            android:textColor="#403A48"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your selected pose will guide the AI when creating your headshot."
            android:textColor="#77727F"
            android:textSize="12sp" />

        <!-- Confident Standing -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConfident"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#F1E9FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#E1D5F4"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#E2D5FF"
                    android:gravity="center"
                    android:text="🧍"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confident Standing"
                        android:textColor="#403A48"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Straight posture with a confident professional appearance."
                        android:textColor="#77727F"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#6C4AB6"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Arms Crossed -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardArmsCrossed"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFF0F7"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#F1DCE8"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#FFDCEB"
                    android:gravity="center"
                    android:text="🙆"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arms Crossed"
                        android:textColor="#403A48"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Confident and authoritative professional pose."
                        android:textColor="#77727F"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#D94C9B"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Relaxed -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRelaxed"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EAF6FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#D8EAF7"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#D8EEFF"
                    android:gravity="center"
                    android:text="🙂"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relaxed Portrait"
                        android:textColor="#403A48"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Natural and approachable portrait pose."
                        android:textColor="#77727F"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#3D83C6"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Seated -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSeated"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFF7E8"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="#F0E3C8"
            app:strokeWidth="1dp"
            app:checkedIcon="@drawable/ic_check">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="#FFECC7"
                    android:gravity="center"
                    android:text="🪑"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seated Professional"
                        android:textColor="#403A48"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Polished seated portrait suitable for professional profiles."
                        android:textColor="#77727F"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#C68A32"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>