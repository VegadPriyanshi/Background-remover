<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FBF8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="#EEE7FA"
                android:gravity="center"
                android:text="‹"
                android:textColor="#6C4AB6"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Background"
                    android:textColor="#403A48"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Describe the environment you want"
                    android:textColor="#77727F"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- AI Banner -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#F1E9FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ AI Background"
                    android:textColor="#6C4AB6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Describe any environment and AI will use it when creating your headshot."
                    android:textColor="#77727F"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Input -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="YOUR BACKGROUND"
            android:textColor="#6C4AB6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxStrokeColor="#6C4AB6"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBackground"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:gravity="top|start"
                android:hint="e.g. Modern university laboratory"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp"
                android:textColor="#403A48"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Examples -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Try these"
            android:textColor="#403A48"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chipSchool"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FCEAF3"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="🏫  Modern school classroom"
                android:textColor="#403A48"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipLaboratory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#EAF6FF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="🔬  Professional medical laboratory"
                android:textColor="#403A48"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipGarden"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#F1E9FF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="🌳  Beautiful garden"
                android:textColor="#403A48"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Use Background -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseBackground"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="Use Custom Background"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#6C4AB6"
            app:cornerRadius="29dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

</ScrollView>