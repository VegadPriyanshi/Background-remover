<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:background="#FBF8FF">

    <!-- Drag handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="#D8D1E2" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Choose Background"
        android:textColor="#403A48"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Give your photo a new look"
        android:textColor="#7B7483"
        android:textSize="13sp" />

    <!-- Solid Color -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSolidColor"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#F2EAFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="#E6DCF5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="#E3D4FF"
                android:gravity="center"
                android:text="🎨"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solid Color"
                    android:textColor="#403A48"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Choose any background color"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#6C4AB6"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Gallery -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnGallery"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#FFF0F7"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="#F2DDE9"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="#FFDCEB"
                android:gravity="center"
                android:text="🖼"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gallery"
                    android:textColor="#403A48"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Use your own image"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#D34E9A"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Templates -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnTemplates"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#F1EEFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="1dp"
        app:strokeColor="#E0D9F5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="#DED6FF"
                android:gravity="center"
                android:text="✨"
                android:textSize="21sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Templates"
                    android:textColor="#403A48"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ready-made backgrounds"
                    android:textColor="#77727F"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#7354C9"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>