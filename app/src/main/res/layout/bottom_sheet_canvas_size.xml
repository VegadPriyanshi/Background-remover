<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FBF8FF"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Bottom sheet handle -->

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="#D8D0E4" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Canvas Size"
        android:textColor="#403A48"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose a size for your design"
        android:textColor="#7A7185"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Square -->

        <LinearLayout
            android:id="@+id/optionSquare"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_canvas_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="@drawable/bg_canvas_square" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Square"
                android:textColor="#403A48"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 : 1"
                android:textColor="#7A7185"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- Vertical -->

        <LinearLayout
            android:id="@+id/optionVertical"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_canvas_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="48dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_canvas_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Vertical"
                android:textColor="#403A48"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 : 5"
                android:textColor="#7A7185"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- Story -->

        <LinearLayout
            android:id="@+id/optionStory"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_canvas_option"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="42dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_canvas_story" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Story"
                android:textColor="#403A48"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9 : 16"
                android:textColor="#7A7185"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>